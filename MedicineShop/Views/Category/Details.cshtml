@model BLL.DTOs.CategoryDTO

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-4">
    <h2><i class="bi bi-info-circle"></i> Category Details</h2>
    <hr />

    <div class="card shadow-sm col-md-6">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@Model.Name</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4 text-muted">Category ID</dt>
                <dd class="col-sm-8 fw-bold">@Model.CategoryId</dd>

                <dt class="col-sm-4 text-muted">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Description</dt>
                <dd class="col-sm-8">@Model.Describe</dd>
            </dl>
        </div>
        <div class="card-footer bg-light">
            <a asp-action="update" asp-route-id="@Model.CategoryId" class="btn btn-warning">Edit</a>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
        </div>
    </div>
</div>
