@model BLL.DTOs.CategoryDTO

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Delete Confirmation</h2>
    <hr />

    <div class="alert alert-danger shadow-sm col-md-6" role="alert">
        <h4 class="alert-heading">Are you sure you want to delete this?</h4>
        <p>This action cannot be undone.</p>
        <hr>
        
        <dl class="row mb-0">
            <dt class="col-sm-4">Category ID</dt>
            <dd class="col-sm-8">@Model.CategoryId</dd>

            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8 text-break">@Model.Describe</dd>
        </dl>
        <hr>

        <form asp-action="delete" method="post" class="mt-3">
            <input type="hidden" asp-for="CategoryId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Permanently Delete
            </button>
            <a asp-action="Index" class="btn btn-outline-dark ms-2">Cancel</a>
        </form>
    </div>
</div>
