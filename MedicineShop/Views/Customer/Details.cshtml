@model BLL.DTOs.CustomerDTO

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-info-circle text-info"></i> Customer Details</h2>
    <hr />

    <div class="card shadow-sm col-md-8 mx-auto border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@Model.Name</h4>
            <span class="badge bg-light text-primary fs-6">ID: #@Model.CustomerId</span>
        </div>

        <div class="card-body bg-light">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Phone</dt>
                <dd class="col-sm-8 fw-bold">@Model.Phone</dd>

                <dt class="col-sm-4 text-muted">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4 text-muted">Address</dt>
                <dd class="col-sm-8">@Model.Address</dd>
            </dl>
        </div>

        <div class="card-footer text-end bg-white">
            <a asp-action="update" asp-route-id="@Model.CustomerId" class="btn btn-warning px-4 text-dark fw-bold">
                <i class="bi bi-pencil-square"></i> Edit Customer
            </a>
            <a asp-action="Index" class="btn btn-secondary ms-2 px-4">Back to List</a>
        </div>
    </div>
</div>
