@model BLL.DTOs.CustomerDTO

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-trash text-danger"></i> Delete Customer</h2>
    <hr />

    <div class="alert alert-warning col-md-8 mx-auto shadow-sm">
        <strong>Warning:</strong> This action will permanently delete the customer record.
    </div>

    <div class="card shadow-sm col-md-8 mx-auto border-0">
        <div class="card-body bg-light">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Customer ID</dt>
                <dd class="col-sm-8">#@Model.CustomerId</dd>

                <dt class="col-sm-4 text-muted">Name</dt>
                <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Phone</dt>
                <dd class="col-sm-8">@Model.Phone</dd>

                <dt class="col-sm-4 text-muted">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4 text-muted">Address</dt>
                <dd class="col-sm-8">@Model.Address</dd>
            </dl>
        </div>
        <div class="card-footer bg-white text-end">
            <form asp-action="delete" method="post" class="d-inline">
                <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
                <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-danger px-4">Delete Customer</button>
            </form>
        </div>
    </div>
</div>
