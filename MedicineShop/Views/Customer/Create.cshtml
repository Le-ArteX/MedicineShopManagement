@model BLL.DTOs.CustomerDTO

@{
    ViewData["Title"] = "Create Customer";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-person-plus text-primary"></i> Create Customer</h2>
    <hr />

    <div class="card shadow-sm p-4 col-md-8 mx-auto bg-light">
        <form asp-action="create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Customer name" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label fw-bold">Phone</label>
                    <input asp-for="Phone" class="form-control" placeholder="Phone number" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Address" class="form-label fw-bold">Address</label>
                    <input asp-for="Address" class="form-control" placeholder="Customer address" />
                </div>
            </div>

            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save"></i> Save Customer</button>
            </div>
        </form>
    </div>
</div>
