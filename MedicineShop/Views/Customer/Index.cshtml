@using System.Linq
@using Microsoft.AspNetCore.Http
@model List<BLL.DTOs.CustomerDTO>

@{
    ViewData["Title"] = "Customer List";
    var searchQuery = ViewData["SearchQuery"]?.ToString();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-0 text-primary">Customer List</h2>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <div class="text-muted small mt-1">Showing results for "<strong>@searchQuery</strong>"</div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form class="d-flex gap-2" method="get" asp-action="Index" role="search">
                <input class="form-control" type="search" name="q" value="@searchQuery" placeholder="Search customers" aria-label="Search customers" />
                <button class="btn btn-outline-primary" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                }
            </form>
            <a asp-action="create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle"></i> +Create New Customer
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded bg-white">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">ID</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th class="text-center" style="width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle ps-3 text-muted">@item.CustomerId</td>
                            <td class="align-middle fw-bold">@item.Name</td>
                            <td class="align-middle">@item.Phone</td>
                            <td class="align-middle">@item.Email</td>
                            <td class="align-middle text-truncate" style="max-width: 200px;">@item.Address</td>
                            
                            <td class="text-center align-middle">
                                <a asp-action="update" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-warning">Edit</a>
                                <a asp-action="details" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="delete" asp-route-id="@item.CustomerId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No customers found. Click the "Create New Customer" button to get started!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

