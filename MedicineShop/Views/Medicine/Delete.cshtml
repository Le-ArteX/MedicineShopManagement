@model BLL.DTOs.MedicineDTO
@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Delete Confirmation</h2>
    <hr />

    <div class="alert alert-danger shadow-sm col-md-6 bg-white border border-danger" role="alert">
        <h4 class="alert-heading text-danger">Are you sure you want to delete this medicine?</h4>
        <p>This will permanently remove it from inventory. This action cannot be undone.</p>
        <hr>
        
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Medicine ID</dt>
            <dd class="col-sm-8 fw-bold">@Model.MedicineId</dd>

            <dt class="col-sm-4 text-muted">Name</dt>
            <dd class="col-sm-8 text-primary fw-bold">@Model.Name (@Model.Brand)</dd>

            <dt class="col-sm-4 text-muted">Stock Remaining</dt>
            <dd class="col-sm-8">@Model.StockQuantity</dd>
        </dl>
        <hr>

        <form asp-action="delete" method="post" class="mt-3">
            <input type="hidden" asp-for="MedicineId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Permanently Delete
            </button>
            <a asp-action="Index" class="btn btn-outline-dark ms-2">Cancel</a>
        </form>
    </div>
</div>
