@using System.Linq
@using Microsoft.AspNetCore.Http
@model List<BLL.DTOs.MedicineDTO>
@{
    ViewData["Title"] = "Medicine Inventory";
    var role = Context.Session.GetString("Urole");
    var isAdmin = role == "Admin";
    var searchQuery = ViewData["SearchQuery"]?.ToString();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-0 text-primary">Medicine Inventory</h2>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <div class="text-muted small mt-1">Showing results for "<strong>@searchQuery</strong>"</div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form class="d-flex gap-2" method="get" asp-action="Index" role="search">
                <input class="form-control" type="search" name="q" value="@searchQuery" placeholder="Search medicines" aria-label="Search medicines" />
                <button class="btn btn-outline-primary" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                }
            </form>
            @if (isAdmin)
            {
                <a asp-action="create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle"></i> Add New Medicine
                </a>
            }
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded bg-white">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-light text-center">
                <tr>
                    <th>ID</th>
                    <th>Medicine Name</th>
                    <th>Generic Name</th>
                    <th>Brand</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Expiry Date</th>
                    <th style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle text-muted text-center">@item.MedicineId</td>
                            <td class="align-middle fw-bold text-primary">@item.Name</td>
                            <td class="align-middle">@item.GenericName</td>
                            <td class="align-middle">@item.Brand</td>
                            <td class="align-middle text-success fw-bold text-end">৳@item.UnitPrice.ToString("N2")</td>

                            <td class="align-middle text-center fw-bold @((item.StockQuantity <= item.MinStockLevel) ? "text-danger" : "")">
                                @item.StockQuantity
                            </td>

                            <td class="align-middle text-center @((item.ExpiryDate <= DateOnly.FromDateTime(DateTime.Now.AddDays(30))) ? "text-danger fw-bold" : "")">
                                @item.ExpiryDate.ToString("yyyy-MM-dd")
                            </td>

                            <td class="text-center align-middle">
                                <a asp-action="details" asp-route-id="@item.MedicineId" class="btn btn-sm btn-outline-info">Details</a>
                                @if (isAdmin)
                                {
                                    <a asp-action="update" asp-route-id="@item.MedicineId" class="btn btn-sm btn-outline-warning">Edit</a>
                                    <a asp-action="delete" asp-route-id="@item.MedicineId" class="btn btn-sm btn-outline-danger">Del</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No medicines found in inventory.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Medicine pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-q="@searchQuery">Previous</a>
                </li>
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@searchQuery">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-q="@searchQuery">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
