@model BLL.DTOs.MedicineDTO
@{
    ViewData["Title"] = "Update Medicine";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-pencil-square text-warning"></i> Update Medicine</h2>
    <hr />
    
    <div class="card shadow-sm p-4 col-md-8 mx-auto bg-light">
        <form asp-action="update" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <input type="hidden" asp-for="MedicineId" />

            <!-- Using the exact same grid layout as Create -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GenericName" class="form-label fw-bold">Generic Name</label>
                    <input asp-for="GenericName" class="form-control" />
                    <span asp-validation-for="GenericName" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Brand" class="form-label fw-bold"></label>
                    <input asp-for="Brand" class="form-control" />
                    <span asp-validation-for="Brand" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="UnitPrice" class="form-label fw-bold">Unit Price ($)</label>
                    <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="StockQuantity" class="form-label fw-bold">Stock</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="MinStockLevel" class="form-label fw-bold">Min Alert Level</label>
                    <input asp-for="MinStockLevel" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ExpiryDate" class="form-label fw-bold">Expiry Date</label>
                    <input asp-for="ExpiryDate" type="date" class="form-control" />
                </div>
            </div>

            <input type="hidden" asp-for="CategoryId" />
            <input type="hidden" asp-for="SupplierId" />

            <div class="text-end">
                <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-success px-4"><i class="bi bi-save"></i> Save Changes</button>
            </div>
        </form>
    </div>
</div>@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
