@model BLL.DTOs.PurchaseDTO

@{
    ViewData["Title"] = "Delete Purchase";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-trash text-danger"></i> Delete Purchase</h2>
    <hr />

    <div class="alert alert-danger shadow-sm col-md-8 mx-auto" role="alert">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this purchase?</h4>
        <p>This action cannot be undone. All data related to this purchase invoice will be permanently removed.</p>
        <hr>
        
        <dl class="row mb-0">
            <dt class="col-sm-4">Invoice No:</dt>
            <dd class="col-sm-8 fw-bold">@Model.InvoiceNo</dd>

            <dt class="col-sm-4">Date:</dt>
            <dd class="col-sm-8">@Model.PurchaseDate.ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-4">Amount:</dt>
            <dd class="col-sm-8">৳@Model.TotalAmount.ToString("N2")</dd>
            
            <dt class="col-sm-4">Supplier ID:</dt>
            <dd class="col-sm-8">@Model.SupplierId</dd>
        </dl>
    </div>

    <div class="col-md-8 mx-auto mt-3">
        <form asp-action="delete" method="post" class="d-inline">
            <input type="hidden" asp-for="PurchaseId" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </div>
</div>
