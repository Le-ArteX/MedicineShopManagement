@model BLL.DTOs.PurchaseDTO

@{
    ViewData["Title"] = "Purchase Details";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-info-circle text-info"></i> Purchase Details</h2>
    <hr />

    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Invoice: @Model.InvoiceNo</h5>
            <span class="badge bg-primary">ID: @Model.PurchaseId</span>
        </div>
        <div class="card-body p-4 bg-light">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Purchase Date</dt>
                <dd class="col-sm-8 fw-bold">@Model.PurchaseDate.ToString("dd MMMM yyyy")</dd>

                <dt class="col-sm-4 text-muted">Total Amount</dt>
                <dd class="col-sm-8 text-success fw-bold fs-5">৳@Model.TotalAmount.ToString("N2")</dd>

                <dt class="col-sm-4 text-muted">Supplier ID</dt>
                <dd class="col-sm-8">@Model.SupplierId</dd>
            </dl>
        </div>
        <div class="card-footer bg-white text-end">
            <a asp-action="update" asp-route-id="@Model.PurchaseId" class="btn btn-warning me-2"><i class="bi bi-pencil"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
