@using Microsoft.AspNetCore.Http
@model IEnumerable<BLL.DTOs.PurchaseDTO>

@{
    ViewData["Title"] = "Purchases";
    var isAdmin = Context.Session.GetString("Urole") == "Admin";
    var searchQuery = ViewData["SearchQuery"]?.ToString();
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2><i class="bi bi-cart"></i> Purchases Management</h2>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <div class="text-muted small mt-1">Showing results for "<strong>@searchQuery</strong>"</div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form class="d-flex gap-2" method="get" asp-action="Index" role="search">
                <input class="form-control" type="search" name="q" value="@searchQuery" placeholder="Search purchases" aria-label="Search purchases" />
                <button class="btn btn-outline-primary" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                }
            </form>
            @if (isAdmin)
            {
                <a asp-action="create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New Purchase</a>
            }
        </div>
    </div>
    <hr />

    @if (TempData["SuccessMessage"] != null && TempData["SuccessMessage"].ToString().Contains("Purchase"))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Invoice No</th>
                        <th>Total Amount</th>
                        <th>Supplier ID</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.PurchaseDate.ToString("dd-MMM-yyyy")</td>
                                <td class="align-middle fw-bold">@item.InvoiceNo</td>
                                <td class="align-middle text-success fw-bold">৳@item.TotalAmount.ToString("N2")</td>
                                <td class="align-middle">@item.SupplierId</td>
                                <td class="align-middle text-center">
                                    <a asp-action="details" asp-route-id="@item.PurchaseId" class="btn btn-sm btn-info text-white" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="update" asp-route-id="@item.PurchaseId" class="btn btn-sm btn-warning text-dark" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="delete" asp-route-id="@item.PurchaseId" class="btn btn-sm btn-danger text-white" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No purchases found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
