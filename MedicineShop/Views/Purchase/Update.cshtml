@model BLL.DTOs.PurchaseDTO

@{
    ViewData["Title"] = "Update Purchase";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-pencil-square text-warning"></i> Update Purchase</h2>
    <hr />
    
    <div class="card shadow-sm p-4 col-md-8 mx-auto bg-light">
        <form asp-action="update" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="PurchaseId" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="InvoiceNo" class="form-label fw-bold">Invoice Number</label>
                    <input asp-for="InvoiceNo" class="form-control" />
                    <span asp-validation-for="InvoiceNo" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PurchaseDate" class="form-label fw-bold">Purchase Date</label>
                    <input asp-for="PurchaseDate" type="date" class="form-control" />
                    <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SupplierId" class="form-label fw-bold">Supplier ID</label>
                    <input asp-for="SupplierId" type="number" class="form-control" />
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TotalAmount" class="form-label fw-bold">Total Amount</label>
                    <div class="input-group">
                        <span class="input-group-text">৳</span>
                        <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" />
                    </div>
                    <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                </div>
            </div>

            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-warning px-4"><i class="bi bi-save"></i> Update Purchase</button>
            </div>
        </form>
    </div>
</div>
