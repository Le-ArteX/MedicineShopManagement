@using System.Linq
@model BLL.DTOs.AdminDTO

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<style>
   
    .bg-dark-blue {
        background-color: #003366 !important;
        color: white;
    }

    .bg-brown {
        background-color: #8B4513 !important;
        color: white;
    }

    .bg-purple {
        background-color: #6f42c1 !important;
        color: white;
    }

    .bg-teal {
        background-color: #008080 !important;
        color: white;
    }
</style>

<div class="container-fluid py-3">
    

    <div class="row g-1 mb-1 text-white">
        <div class="col-md-3">
            <div class="bg-primary p-4 text-center fw-bold">@Model.TotalMedicines Total medicines</div>
        </div>
        <div class="col-md-3">
            <div class="bg-success p-4 text-center fw-bold">@Model.TodayRevenue.ToString("N0") BDT Today revenue</div>
        </div>
        <div class="col-md-3">
            <div class="bg-warning text-dark p-4 text-center fw-bold">@Model.MonthlyRevenue.ToString("N0") BDT Monthly revenue</div>
        </div>
        <div class="col-md-3">
            <div class="bg-danger p-4 text-center fw-bold">@Model.ActiveAlertsCount Active alerts</div>
        </div>
    </div>

    <div class="row g-1 mb-4 text-white">
        <div class="col-md-3">
            <div class="bg-purple p-4 text-center fw-bold">@Model.TotalSales Total sales</div>
        </div>
        <div class="col-md-3">
            <div class="bg-primary p-4 text-center fw-bold">@Model.TotalPurchases Purchases</div>
        </div>
        <div class="col-md-3">
            <div class="bg-teal p-4 text-center fw-bold">@Model.TotalCustomers Customers</div>
        </div>
        <div class="col-md-3">
            <div class="bg-secondary p-4 text-center fw-bold">@Model.TotalSuppliers Suppliers</div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-brown fw-bold">Low stock medicines</div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @* @if (Model.LowStockMedicines.Any())
                        {
                            foreach (var med in Model.LowStockMedicines)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @med.Name
                                    <span>— @med.StockQuantity left <span class="badge bg-danger rounded-pill">[LOW]</span></span>
                                </li>
                            }
                        } *@
                        else
                        {
                            <li class="list-group-item text-muted">Stock levels are healthy.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-brown fw-bold">System alerts</div>
                <div class="card-body p-2">
                    @* @if (Model.SystemAlerts.Any())
                    {
                        foreach (var alert in Model.SystemAlerts)
                        {
                            <p class="text-danger mb-1 border-bottom pb-1">
                                [RED] @alert.Message — @alert.CreatedAt.ToString("MMM dd HH:mm")
                            </p>
                        }
                    } *@
                    else
                    {
                        <p class="text-muted mb-1">No active system alerts.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white fw-bold">Recent sales (all staff)</div>
                <div class="card-body p-2">
                    @* @if (Model.RecentSales.Any())
                    {
                        foreach (var sale in Model.RecentSales)
                        {
                            <div class="border-bottom py-2">
                                @sale.InvoiceNumber | @(sale.Customer?.Name ?? "Walk-in") | @sale.TotalAmount.ToString("N0") BDT
                            </div>
                        }
                    } *@
                    else
                    {
                        <div class="py-2 text-muted">No recent sales found.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-purple fw-bold d-flex justify-content-between align-items-center">
                    <span>User management [Admin only]</span>
                    <span class="badge bg-light text-dark">@Model.TotalStaff Staff</span>
                </div>
                <div class="card-body p-3">
                    <p class="text-muted mb-3">Manage staff accounts from one place.</p>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <a asp-action="Staff" asp-controller="Admin" class="btn btn-sm btn-primary">View Staff</a>
                        <a asp-action="CreateStaff" asp-controller="Admin" class="btn btn-sm btn-success">Add Staff</a>
                    </div>
                    <div class="border-top pt-2">
                        @if (Model.StaffUsers != null && Model.StaffUsers.Any())
                        {
                            foreach (var user in Model.StaffUsers.Take(5))
                            {
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                    <div>
                                        <strong>@user.Name</strong>
                                        <div class="text-muted small">@user.Email</div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-action="DeleteStaff" asp-controller="Admin" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">No staff accounts found.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>