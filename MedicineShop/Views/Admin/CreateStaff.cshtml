@model BLL.DTOs.UserDTO

@{
    ViewData["Title"] = "Create Staff";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-person-plus text-success"></i> Create Staff</h2>
    <hr />

    <div class="card shadow-sm p-4 col-md-8 mx-auto bg-light">
        <form asp-action="CreateStaff" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input asp-for="Role" type="hidden" value="Staff" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Staff name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-bold"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="staff@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-bold"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="alert alert-info py-2">This account will be created with the Staff role.</div>

            <div class="text-end mt-4">
                <a asp-action="Staff" class="btn btn-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-success px-4"><i class="bi bi-save"></i> Save Staff</button>
            </div>
        </form>
    </div>
</div>
