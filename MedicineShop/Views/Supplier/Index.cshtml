@using System.Linq
@using Microsoft.AspNetCore.Http
@model List<BLL.DTOs.SupplierDTO>

@{
    ViewData["Title"] = "Supplier List";
    var isAdmin = Context.Session.GetString("Urole") == "Admin";
    var searchQuery = ViewData["SearchQuery"]?.ToString();
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-0 text-primary">Supplier List</h2>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <div class="text-muted small mt-1">Showing results for "<strong>@searchQuery</strong>"</div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form class="d-flex gap-2" method="get" asp-action="Index" role="search">
                <input class="form-control" type="search" name="q" value="@searchQuery" placeholder="Search suppliers" aria-label="Search suppliers" />
                <button class="btn btn-outline-primary" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                }
            </form>
            @if (isAdmin)
            {
                <a asp-action="create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle"></i> Add New Supplier
                </a>
            }
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded bg-white">
        <table class="table table-bordered table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">ID</th>
                    <th>Company Name</th>
                    <th>Contact Person</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th class="text-center" style="width: 220px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle ps-3 text-muted">@item.SupplierId</td>
                            <td class="align-middle fw-bold">@item.Name</td>
                            <td class="align-middle">@item.ContactPerson</td>
                            <td class="align-middle">@item.Phone</td>
                            <td class="align-middle">@item.Email</td>
                            <td class="text-center align-middle">
                                <a asp-action="details" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-info">Details</a>
                                @if (isAdmin)
                                {
                                    <a asp-action="update" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-warning">Edit</a>
                                    <a asp-action="delete" asp-route-id="@item.SupplierId" class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No suppliers found. Click "Add New Supplier" to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Supplier pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-q="@searchQuery">Previous</a>
                </li>
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@searchQuery">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-q="@searchQuery">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
