@model BLL.DTOs.SupplierDTO

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container mt-4">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Delete Confirmation</h2>
    <hr />

    <div class="alert alert-danger shadow-sm col-md-6 bg-white border border-danger" role="alert">
        <h4 class="alert-heading text-danger">Are you sure you want to delete this supplier?</h4>
        <p>This action cannot be undone.</p>
        <hr>
        
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Supplier ID</dt>
            <dd class="col-sm-8 fw-bold">@Model.SupplierId</dd>

            <dt class="col-sm-4 text-muted">Company Name</dt>
            <dd class="col-sm-8 fw-bold text-primary">@Model.Name</dd>

            <dt class="col-sm-4 text-muted">Contact Person</dt>
            <dd class="col-sm-8">@Model.ContactPerson</dd>
        </dl>
        <hr>

        <form asp-action="delete" method="post" class="mt-3">
            <input type="hidden" asp-for="SupplierId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Permanently Delete
            </button>
            <a asp-action="Index" class="btn btn-outline-dark ms-2">Cancel</a>
        </form>
    </div>
</div>
