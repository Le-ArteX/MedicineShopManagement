@model BLL.DTOs.PurchaseItemDTO

@{
    ViewData["Title"] = "Purchase Item Details";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-info-circle text-info"></i> Purchase Item Details</h2>
    <hr />

    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Item #@Model.PurchaseItemId</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Purchase ID</dt>
                <dd class="col-sm-8 fw-bold">@Model.PurchaseId</dd>

                <dt class="col-sm-4 text-muted">Medicine ID</dt>
                <dd class="col-sm-8">@Model.MedicineId</dd>

                <dt class="col-sm-4 text-muted">Quantity</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-secondary">@Model.Quantity Units</span>
                </dd>

                <dt class="col-sm-4 text-muted">Unit Cost</dt>
                <dd class="col-sm-8 text-success fw-bold">৳@Model.UnitCost.ToString("N2")</dd>
            </dl>
        </div>
        <div class="card-footer text-end mt-2">
            <a asp-action="update" asp-route-id="@Model.PurchaseItemId" class="btn btn-warning me-2">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
