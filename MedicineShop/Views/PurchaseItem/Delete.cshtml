@model BLL.DTOs.PurchaseItemDTO

@{
    ViewData["Title"] = "Delete Purchase Item";
}

<div class="container mt-4 mb-5">
    <h2><i class="bi bi-exclamation-triangle-fill text-danger"></i> Delete Purchase Item</h2>
    <hr />

    <div class="alert alert-danger shadow-sm col-md-8 mx-auto" role="alert">
        <h4 class="alert-heading">Are you sure you want to delete this?</h4>
        <p>This action cannot be undone. Once deleted, all data associated with this purchase item will be permanently removed.</p>
        <hr>

        <div class="bg-white p-3 rounded border text-dark mb-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">Purchase ID</dt>
                <dd class="col-sm-8 fw-bold">@Model.PurchaseId</dd>

                <dt class="col-sm-4 text-muted">Medicine ID</dt>
                <dd class="col-sm-8">@Model.MedicineId</dd>

                <dt class="col-sm-4 text-muted">Quantity</dt>
                <dd class="col-sm-8">@Model.Quantity Units</dd>

                <dt class="col-sm-4 text-muted">Unit Cost</dt>
                <dd class="col-sm-8 fw-bold text-success">৳@Model.UnitCost.ToString("N2")</dd>
            </dl>
        </div>

        <form asp-action="delete" method="post" class="text-end">
            <input type="hidden" name="PurchaseItemId" value="@Model.PurchaseItemId" />
            <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Confirm Delete
            </button>
        </form>
    </div>
</div>
