@model IEnumerable<BLL.DTOs.PurchaseItemDTO>

@{
    ViewData["Title"] = "Purchase Items";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-list-task"></i> Purchase Items</h2>
        <a asp-action="create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New Item</a>
    </div>
    <hr />

    @if (TempData["SuccessMessage"] != null && TempData["SuccessMessage"].ToString().Contains("Purchase"))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Purchase ID</th>
                        <th>Medicine ID</th>
                        <th>Quantity</th>
                        <th>Unit Cost</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.PurchaseId</td>
                                <td class="align-middle">@item.MedicineId</td>
                                <td class="align-middle fw-bold">@item.Quantity</td>
                                <td class="align-middle text-success fw-bold">৳@item.UnitCost.ToString("N2")</td>
                                <td class="align-middle text-center">
                                    <a asp-action="details" asp-route-id="@item.PurchaseItemId" class="btn btn-sm btn-info text-white" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="update" asp-route-id="@item.PurchaseItemId" class="btn btn-sm btn-warning text-dark" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="delete" asp-route-id="@item.PurchaseItemId" class="btn btn-sm btn-danger text-white" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No purchase items found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
