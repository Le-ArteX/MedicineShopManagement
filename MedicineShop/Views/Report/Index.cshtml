@model BLL.DTOs.ReportDTO

@{
    ViewData["Title"] = "Dashboard Report";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up-arrow text-primary"></i> Dashboard Overview</h2>
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer"></i> Print Report
        </button>
    </div>
    <hr />


    <div class="row mb-5">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-2">Total Sales</h6>
                            <h3 class="fw-bold mb-0 text-success">৳@Model.DashboardSummary.TotalSalesRevenue.ToString("N2")</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-cash-coin fs-4 text-success"></i>
                        </div>
                    </div>
                    <div class="mt-3 text-muted small">
                        From <span class="fw-bold text-dark">@Model.DashboardSummary.TotalSalesCount</span> total transactions
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-2">Total Purchases</h6>
                            <h3 class="fw-bold mb-0 text-primary">৳@Model.DashboardSummary.TotalPurchaseCost.ToString("N2")</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-cart-check fs-4 text-primary"></i>
                        </div>
                    </div>
                    <div class="mt-3 text-muted small">
                        From <span class="fw-bold text-dark">@Model.DashboardSummary.TotalPurchaseCount</span> total purchase orders
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-2">Total Medicines</h6>
                            <h3 class="fw-bold mb-0 text-warning text-dark">@Model.DashboardSummary.TotalMedicines <small class="fs-6 text-muted">items</small></h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-capsule fs-4 text-warning"></i>
                        </div>
                    </div>
                    <div class="mt-3 text-muted small">
                        <span class="fw-bold text-danger">@Model.DashboardSummary.LowStockMedicineCount</span> items require stock attention
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Low Stock Alerts</h5>
            <span class="badge bg-danger rounded-pill fs-6">@Model.LowStockMedicines.Count Items</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Medicine ID</th>
                            <th>Name</th>
                            <th>Brand</th>
                            <th class="text-center">Current Stock</th>
                            <th class="text-center">Min Level</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LowStockMedicines != null && Model.LowStockMedicines.Any())
                        {
                            foreach (var item in Model.LowStockMedicines)
                            {
                                <tr>
                                    <td class="align-middle fw-bold">#@item.MedicineId</td>
                                    <td class="align-middle">@item.Name</td>
                                    <td class="align-middle text-muted">@item.Brand</td>
                                    <td class="align-middle text-center text-danger fw-bold">@item.StockQuantity</td>
                                    <td class="align-middle text-center">@item.MinStockLevel</td>
                                    <td class="align-middle text-center">
                                        @if(item.StockQuantity == 0)
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Low Stock</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-success fw-bold">
                                    <i class="bi bi-check-circle fs-4 d-block mb-2"></i>
                                    All medicine stocks are at healthy levels!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white">
                <nav aria-label="Report pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
                        </li>
                        @for (var i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
